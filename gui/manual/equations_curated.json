 ],
 "hfs-energy": [
  "$\\Delta E_F = \\frac{A}{2}\\, C + B\\, \\frac{\\frac{3}{2} C(C+1) - 2 I(I+1) J(J+1)}{4 I(2I-1) J(2J-1)}$",
  "$C = F(F+1) - I(I+1) - J(J+1)$"
