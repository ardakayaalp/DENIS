{
 "transition-frequency": [
  "$\\nu_0 = (E_{\\mathrm{upper}} - E_{\\mathrm{lower}}) \\cdot c \\cdot 100 \\,/\\, 10^{6}\\ \\mathrm{MHz}$"
 ],
 "beta-from-voltage": [
  "$\\beta = \\sqrt{1 - \\left(\\frac{E_0}{q e V + E_0}\\right)^2}$",
  "$E_0 = m c^2$"
 ],
 "voltage-from-beta": [
  "$\\gamma = \\frac{1}{\\sqrt{1 - \\beta^2}}$",
  "$V = \\frac{(\\gamma - 1)\\, m c^2}{q e}$"
 ],
 "doppler-seen": [
  "$\\nu_{\\mathrm{seen}} = \\nu_{\\mathrm{lab}} \\sqrt{\\frac{1 + \\beta}{1 - \\beta}}\\quad (\\mathrm{anti\\text-collinear})$",
  "$\\nu_{\\mathrm{seen}} = \\nu_{\\mathrm{lab}} \\sqrt{\\frac{1 - \\beta}{1 + \\beta}}\\quad (\\mathrm{collinear})$"
 ],
 "resonance-beta": [
  "$r = \\frac{\\nu_{\\mathrm{laser}}}{\\nu_{\\mathrm{rest}}}$",
  "$\\beta_{\\mathrm{anti}} = \\frac{1 - r^2}{1 + r^2}\\quad (\\mathrm{anti\\text-collinear})$",
  "$\\beta_{\\mathrm{col}} = \\frac{r^2 - 1}{r^2 + 1}\\quad (\\mathrm{collinear})$"
 ],
 "laser-frequency-resonance": [
  "$\\nu_{\\mathrm{laser}} = \\nu_{\\mathrm{rest}} \\sqrt{\\frac{1 - \\beta}{1 + \\beta}}\\quad (\\mathrm{anti\\text-collinear})$",
  "$\\nu_{\\mathrm{laser}} = \\nu_{\\mathrm{rest}} \\sqrt{\\frac{1 + \\beta}{1 - \\beta}}\\quad (\\mathrm{collinear})$"
 ],
 "fwhm-to-sigma": [
  "$\\sigma = \\frac{\\mathrm{FWHM}}{2 \\sqrt{2 \\ln 2}}$"
 ],
 "simulated-spectrum": [
  "$y(\\Delta V) = \\sum_k a_k \\exp\\!\\left(-\\frac{(\\nu_{\\mathrm{seen}}(\\Delta V) - (\\nu_c + \\delta_k))^2}{2 \\sigma^2}\\right)$"
 ],
 "lab-laser-frequency": [
  "$\\nu_{\\mathrm{lab}}\\,[\\mathrm{MHz}] = \\lambda\\,[\\mathrm{cm}^{-1}] \\cdot h \\cdot c \\cdot 100 \\,/\\, 10^{6}$"
 ],
 "beam-energy-from-frequency": [
