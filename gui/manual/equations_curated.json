 ],
 "two-particle-lande": [
  "$g(I) = \\frac{1}{2}(g_1 + g_2) + \\frac{1}{2}(g_1 - g_2)\\,\\frac{j_1(j_1+1) - j_2(j_2+1)}{I(I+1)}$",
